<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms — только для встраивания элемента просмотра eDrawings (ActiveX); его глобальные using не нужны. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!--
      Без аппаратной защиты стека Intel CET (теневой стек). Запускатель .NET по умолчанию помечен как совместимый с CET,
      и Windows включает теневой стек всему процессу; элемент просмотра eDrawings с ним несовместим — процесс аварийно
      завершается (0xC0000409, FAST_FAIL_CONTROL_INVALID_RETURN_ADDRESS) при создании элемента. Проверено 25.11.2026, eDrawings 2026.
    -->
    <CetCompat>false</CetCompat>
    <AssemblyName>SolidBrew</AssemblyName>
    <RootNamespace>SolidBrew.Client</RootNamespace>
    <Product>SolidBrew PDM</Product>
    <AssemblyTitle>SolidBrew PDM — клиент</AssemblyTitle>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SolidBrew.Core\SolidBrew.Core.csproj" />
    <ProjectReference Include="..\SolidBrew.Workspace\SolidBrew.Workspace.csproj" />
    <ProjectReference Include="..\SolidBrew.Adapters.SolidWorks\SolidBrew.Adapters.SolidWorks.csproj" />
    <ProjectReference Include="..\SolidBrew.Adapters.TestCad\SolidBrew.Adapters.TestCad.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SolidBrew.Client.Tests" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
</Project>
