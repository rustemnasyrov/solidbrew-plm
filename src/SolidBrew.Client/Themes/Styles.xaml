<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:inf="clr-namespace:SolidBrew.Client.Infrastructure">

    <inf:MarkToBrushConverter x:Key="MarkBrush" />
    <inf:BoolToVisibilityConverter x:Key="BoolVis" />
    <inf:NullToVisibilityConverter x:Key="NullVis" />
    <inf:CountToVisibilityConverter x:Key="CountVis" />
    <inf:InverseBoolConverter x:Key="Not" />

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <SolidColorBrush x:Key="AccentBrush" Color="#1F5FA8" />
    <SolidColorBrush x:Key="PanelBrush" Color="#F4F6F9" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D5DAE1" />
    <SolidColorBrush x:Key="MutedBrush" Color="#5F6670" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C62828" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B26A00" />
    <SolidColorBrush x:Key="NoticeBrush" Color="#FFF4CE" />

    <Style TargetType="Window" x:Key="AppWindow">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="White" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <!-- Глиф Segoe MDL2 / Fluent Icons. -->
    <Style TargetType="TextBlock" x:Key="Icon">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Кнопка: Tag — глиф, Content — текст. -->
    <Style TargetType="Button" x:Key="IconButton" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Margin="0,0,6,0"
                                   Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource IconButton}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinWidth" Value="110" />
        <Setter Property="Padding" Value="12,4" />
    </Style>

    <Style TargetType="Button" x:Key="PlainButton" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="MinWidth" Value="90" />
        <Setter Property="MinHeight" Value="26" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="3,2" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="24" />
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Padding" Value="3,2" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="24" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="TextBlock" x:Key="Header">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="TextBlock" x:Key="SubHeader">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,8,0,4" />
    </Style>

    <Style TargetType="TextBlock" x:Key="Muted">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="Border" x:Key="Toolbar">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="8,6" />
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#E6E9EE" />
        <Setter Property="AlternatingRowBackground" Value="#FAFBFC" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="MinRowHeight" Value="24" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderThickness="0">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Цветная метка состояния (кружок). DataContext должен иметь свойство Mark. -->
    <DataTemplate x:Key="MarkCell">
        <Ellipse Width="10" Height="10" Fill="{Binding Mark, Converter={StaticResource MarkBrush}}" HorizontalAlignment="Center" />
    </DataTemplate>

    <!-- Список проблем: ошибки (блокирующие) красным, предупреждения оранжевым. -->
    <DataTemplate x:Key="ProblemTemplate">
        <DockPanel Margin="0,1">
            <TextBlock x:Name="Ico" DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{Binding Icon}" Margin="0,1,6,0"
                       VerticalAlignment="Top" Foreground="{StaticResource MutedBrush}" />
            <TextBlock x:Name="Txt" Text="{Binding Message}" TextWrapping="Wrap" />
        </DockPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsBlocking}" Value="True">
                <Setter TargetName="Ico" Property="Foreground" Value="{StaticResource ErrorBrush}" />
                <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource ErrorBrush}" />
                <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                <Setter TargetName="Ico" Property="Foreground" Value="{StaticResource WarningBrush}" />
                <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource WarningBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Легенда цветовых меток. -->
    <DataTemplate x:Key="LegendItem">
        <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
            <Ellipse Width="10" Height="10" Fill="{Binding Brush}" Margin="0,0,4,0" />
            <TextBlock Text="{Binding Text}" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
