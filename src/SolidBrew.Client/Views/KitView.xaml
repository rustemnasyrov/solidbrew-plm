<UserControl x:Class="SolidBrew.Client.Views.KitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:SolidBrew.Client.Infrastructure"
             xmlns:vm="clr-namespace:SolidBrew.Client.ViewModels">
    <DockPanel Margin="8,6">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource Header}" FontSize="14" />

        <!-- Версия и команды -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock Text="Версия" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" Width="80" Margin="0,0,12,0" ItemStringFormat="v{0}" />
            <Button Style="{StaticResource PrimaryButton}" MinWidth="0" Tag="&#xE896;" Content="Открыть" Command="{Binding OpenCommand}"
                    ToolTip="Открыть выделенный документ (его версию в комплекте) в рабочую папку" />
            <Button Style="{StaticResource IconButton}" Tag="&#xE72E;" Content="Взять в работу" Command="{Binding CheckOutCommand}"
                    Visibility="{Binding CanModify, Converter={StaticResource BoolVis}}" />
            <Button Style="{StaticResource IconButton}" Tag="&#xE898;" Content="Сдать" Command="{Binding CheckinCommand}"
                    Visibility="{Binding CanModify, Converter={StaticResource BoolVis}}" />
            <Button Style="{StaticResource IconButton}" Tag="&#xE785;" Content="Отменить взятие" Command="{Binding UndoCheckOutCommand}"
                    Visibility="{Binding CanModify, Converter={StaticResource BoolVis}}" />
            <Button Style="{StaticResource IconButton}" Tag="&#xE777;" Content="Обновить до последней" Command="{Binding UpdateToLatestCommand}"
                    ToolTip="Разложить в рабочую папку последние версии отмеченных документов" />
            <Button Style="{StaticResource IconButton}" Tag="&#xE71B;" Content="Где применяется" Command="{Binding WhereUsedCommand}" />
            <Button Style="{StaticResource IconButton}" Tag="&#xE8AC;" Content="Переименовать" Command="{Binding RenameCommand}"
                    Visibility="{Binding CanModify, Converter={StaticResource BoolVis}}" />
            <Button Style="{StaticResource IconButton}" Tag="&#xE8A5;" Content="Документ" Command="{Binding ShowDocumentCommand}" />
            <Button Style="{StaticResource IconButton}" Tag="&#xE8E5;" Content="Открыть файл" Command="{Binding OpenFileCommand}"
                    ToolTip="Открыть файл из рабочей папки в CAD" />
            <Button Style="{StaticResource IconButton}" Tag="&#xE72D;" Content="Выгрузить" Command="{Binding ExportCommand}" />
            <Button Style="{StaticResource IconButton}" Tag="&#xE72C;" Content="Обновить" Command="{Binding RefreshCommand}" />
        </WrapPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Tag="&#xE894;" Content="Снять отметки" Command="{Binding ClearChecksCommand}" />
                <Button Style="{StaticResource IconButton}" Tag="&#xE710;" Content="Развернуть" Command="{Binding ExpandAllCommand}" />
                <Button Style="{StaticResource IconButton}" Tag="&#xE738;" Content="Свернуть" Command="{Binding CollapseAllCommand}" Margin="0" />
            </StackPanel>
            <ItemsControl ItemsSource="{x:Static inf:Legend.Items}" ItemTemplate="{StaticResource LegendItem}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Margin="0,4,0,0"
                   Text="Команды выполняются над отмеченными флажками документами, а если отметок нет — над выделенным." />

        <!-- Заголовки колонок -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,1,0" Padding="0,4">
            <StackPanel Orientation="Horizontal" TextBlock.FontWeight="SemiBold">
                <TextBlock Width="77" />
                <TextBlock Width="340" Text="Файл" />
                <TextBlock Width="190" Text="Обозначение" />
                <TextBlock Width="230" Text="Наименование" />
                <TextBlock Width="100" Text="Версия / посл." />
                <TextBlock Text="Состояние" />
            </StackPanel>
        </Border>

        <TreeView ItemsSource="{Binding Roots}" BorderBrush="{StaticResource BorderBrush}">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    <Setter Property="Padding" Value="0,1" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type vm:KitNodeViewModel}" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" ToolTip="{Binding Tooltip}">
                        <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,4,0"
                                  Visibility="{Binding IsUnresolved, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                        <Ellipse Width="10" Height="10" Fill="{Binding Mark, Converter={StaticResource MarkBrush}}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Icon}" Text="{Binding KindIcon}" Margin="0,0,6,0" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Width="{Binding NameWidth}" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                        <TextBlock Width="184" Text="{Binding Designation}" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                        <TextBlock Width="224" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                        <TextBlock Width="94" Text="{Binding VersionText}" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding StateText}" Foreground="{Binding Mark, Converter={StaticResource MarkBrush}}" />
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </DockPanel>
</UserControl>
