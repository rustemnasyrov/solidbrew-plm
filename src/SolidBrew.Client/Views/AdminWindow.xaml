<Window x:Class="SolidBrew.Client.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:SolidBrew.Client.Views"
        Style="{StaticResource AppWindow}"
        Width="1100" Height="720" MinWidth="820" MinHeight="480">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button Style="{StaticResource IconButton}" Tag="&#xE72C;" Content="Обновить" Command="{Binding RefreshAllCommand}" />
                    <Button Style="{StaticResource PlainButton}" Content="Закрыть" Command="{Binding CloseWindowCommand}" IsCancel="True" />
                </StackPanel>
                <v:BusyBar DataContext="{Binding Busy}" />
            </DockPanel>
        </Border>
        <TextBlock DockPanel.Dock="Top" Text="Администрирование" Style="{StaticResource Title}" Margin="18,14,18,4" />
        <v:AdminView />
    </DockPanel>
</Window>
