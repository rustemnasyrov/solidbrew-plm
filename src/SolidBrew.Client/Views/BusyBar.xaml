<UserControl x:Class="SolidBrew.Client.Views.BusyBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext — BusyState: текст хода, полоса, «Отменить». -->
    <DockPanel LastChildFill="True" MinHeight="26">
        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Tag="&#xE711;" Content="Отменить" Margin="8,0,0,0"
                Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"
                ToolTip="Прервать текущую операцию" />
        <ProgressBar DockPanel.Dock="Right" Width="180" Height="12" Margin="8,0,0,0" Minimum="0" Maximum="100"
                     Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" />
        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" />
    </DockPanel>
</UserControl>
