<Window x:Class="SolidBrew.Client.Views.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        SizeToContent="WidthAndHeight" MinWidth="380" MaxWidth="760" MaxHeight="640"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel x:Name="Buttons" DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0" />
        <TextBlock x:Name="IconText" DockPanel.Dock="Left" Style="{StaticResource Icon}" FontSize="28" VerticalAlignment="Top" Margin="0,0,14,0" />
        <StackPanel>
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" MaxWidth="620" />
            <ScrollViewer x:Name="DetailsScroll" Margin="0,10,0,0" MaxHeight="360" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <ItemsControl x:Name="DetailsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <TextBlock DockPanel.Dock="Left" Text="•" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="590" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </DockPanel>
</Window>
