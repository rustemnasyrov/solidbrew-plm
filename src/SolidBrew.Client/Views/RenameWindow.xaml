<Window x:Class="SolidBrew.Client.Views.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:SolidBrew.Client.Views"
        Style="{StaticResource AppWindow}"
        Width="820" Height="560" MinWidth="600" MinHeight="400" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Toolbar}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button Style="{StaticResource IconButton}" Tag="&#xE721;" Content="Проверить" Command="{Binding CheckCommand}" />
                    <Button Style="{StaticResource PrimaryButton}" Tag="&#xE8AC;" Content="Переименовать и сдать" Command="{Binding RenameCommand}" />
                    <Button Style="{StaticResource PlainButton}" Content="Закрыть" Command="{Binding CancelCommand}" IsCancel="True" />
                </StackPanel>
                <v:BusyBar DataContext="{Binding Busy}" />
            </DockPanel>
        </Border>
        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Сейчас" Margin="0,0,10,6" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding OldRelPath, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,6" Background="{StaticResource PanelBrush}" />
            <TextBlock Grid.Row="1" Text="Новый путь" Margin="0,0,10,6" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NewRelPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
            <TextBlock Grid.Row="2" Text="Комментарий" Margin="0,0,10,6" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
            <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,4,0,6" FontWeight="SemiBold" />
            <Border Grid.Row="4" Grid.ColumnSpan="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="6" MaxHeight="140" Margin="0,0,0,8"
                    Visibility="{Binding Problems.Count, Converter={StaticResource CountVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemTemplate}" />
                </ScrollViewer>
            </Border>
            <DockPanel Grid.Row="5" Grid.ColumnSpan="2">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SubHeader}" Margin="0,0,0,4"
                           Text="Ссылающиеся документы: будут взяты в работу, ссылки исправлены, всё сдано одной операцией" />
                <DataGrid ItemsSource="{Binding Parents}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="22" CellTemplate="{StaticResource MarkCell}" />
                        <DataGridTextColumn Header="Файл" Binding="{Binding RelPath}" Width="2*" />
                        <DataGridTextColumn Header="Обозначение" Binding="{Binding Designation}" Width="*" />
                        <DataGridTextColumn Header="Версия" Binding="{Binding VersionText}" Width="Auto" />
                        <DataGridTextColumn Header="Блокировка" Binding="{Binding LockText}" Width="1.5*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
