<UserControl x:Class="SolidBrew.Client.Views.WorkFolderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:SolidBrew.Client.Infrastructure">
    <DockPanel Margin="8,6">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Header}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,6" />
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button Style="{StaticResource IconButton}" Tag="&#xE72E;" Content="Взять в работу" Command="{Binding CheckOutCommand}"
                    Visibility="{Binding CanModify, Converter={StaticResource BoolVis}}" />
            <Button Style="{StaticResource PrimaryButton}" MinWidth="0" Tag="&#xE898;" Content="Сдать…" Command="{Binding CheckinCommand}"
                    Visibility="{Binding CanModify, Converter={StaticResource BoolVis}}" />
            <Button Style="{StaticResource IconButton}" Tag="&#xE785;" Content="Отменить взятие" Command="{Binding UndoCheckOutCommand}"
                    Visibility="{Binding CanModify, Converter={StaticResource BoolVis}}" />
            <Button Style="{StaticResource IconButton}" Tag="&#xE777;" Content="Обновить до последней" Command="{Binding UpdateToLatestCommand}" />
            <Button Style="{StaticResource IconButton}" Tag="&#xE8AC;" Content="Переименовать" Command="{Binding RenameCommand}"
                    Visibility="{Binding CanModify, Converter={StaticResource BoolVis}}" />
            <Button Style="{StaticResource IconButton}" Tag="&#xE8E5;" Content="Открыть файл" Command="{Binding OpenFileCommand}" ToolTip="Открыть файл в CAD" />
            <Button Style="{StaticResource IconButton}" Tag="&#xE8A5;" Content="Документ" Command="{Binding ShowDocumentCommand}" />
            <Button Style="{StaticResource IconButton}" Tag="&#xE8F1;" Content="Комплект папки" Command="{Binding ShowHeadKitCommand}" ToolTip="Дерево комплекта, открытого в эту папку" />
            <Button Style="{StaticResource IconButton}" Tag="&#xEC50;" Content="Показать файл" Command="{Binding ShowFileInExplorerCommand}" />
            <Button Style="{StaticResource IconButton}" Tag="&#xE72C;" Content="Обновить" Command="{Binding RefreshCommand}" />
        </WrapPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center"
                       Text="Выделите несколько строк (Ctrl, Shift), чтобы выполнить команду для всех." />
            <ItemsControl ItemsSource="{x:Static inf:Legend.Items}" ItemTemplate="{StaticResource LegendItem}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DockPanel>
        <DataGrid ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" SelectionMode="Extended" EnableRowVirtualization="False">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="22" CellTemplate="{StaticResource MarkCell}" />
                <DataGridTextColumn Header="Файл" Binding="{Binding RelPath}" Width="2*" />
                <DataGridTextColumn Header="Обозначение" Binding="{Binding Designation}" Width="*" />
                <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="В папке" Binding="{Binding LocalVersionText}" Width="Auto" />
                <DataGridTextColumn Header="Последняя" Binding="{Binding LatestVersionText}" Width="Auto" />
                <DataGridTextColumn Header="Состояние" Binding="{Binding StateText}" Width="1.6*" />
                <DataGridTextColumn Header="Атрибут" Binding="{Binding ReadOnlyText}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
