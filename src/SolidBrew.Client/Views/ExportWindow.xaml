<Window x:Class="SolidBrew.Client.Views.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:SolidBrew.Client.Views"
        Style="{StaticResource AppWindow}"
        Width="640" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Toolbar}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Tag="&#xE72D;" Content="Выгрузить" Command="{Binding ExportCommand}" IsDefault="True" />
                    <Button Style="{StaticResource PlainButton}" Content="Закрыть" Command="{Binding CancelCommand}" IsCancel="True" />
                </StackPanel>
                <v:BusyBar DataContext="{Binding Busy}" />
            </DockPanel>
        </Border>
        <StackPanel Margin="16">
            <TextBlock Style="{StaticResource Header}" Text="{Binding DocumentText}" />
            <TextBlock Style="{StaticResource SubHeader}" Text="Версия комплекта" Margin="0,4,0,4" />
            <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" Width="420" HorizontalAlignment="Left">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="v" /><Run Text="{Binding Number, Mode=OneWay}" />
                            <Run Text=" — " /><Run Text="{Binding AuthorDisplayName, Mode=OneWay}" />
                            <Run Text="{Binding Comment, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Style="{StaticResource SubHeader}" Text="Состав" />
            <CheckBox IsChecked="True" IsEnabled="False" Content="Исходные файлы с относительными путями и перечень версий и хешей (manifest.json)" />
            <CheckBox IsChecked="{Binding IncludeDerived}" Margin="0,4,0,0" Content="Включить производные файлы (PDF, STEP, DXF, Gerber…)" />
            <TextBlock Style="{StaticResource SubHeader}" Text="Куда сохранить ZIP" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Tag="&#xE838;" Content="Обзор…" Command="{Binding BrowseCommand}" Margin="6,0,0,0" />
                <TextBox Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
        </StackPanel>
    </DockPanel>
</Window>
