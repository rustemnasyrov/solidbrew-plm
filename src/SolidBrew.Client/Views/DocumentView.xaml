<UserControl x:Class="SolidBrew.Client.Views.DocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8,6">
        <TextBlock Text="Документ не выбран. Выберите документ в обзоре или в дереве комплекта и нажмите «Документ»." Style="{StaticResource Muted}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding HasDocument, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
        <DockPanel Visibility="{Binding HasDocument, Converter={StaticResource BoolVis}}">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Header}" Text="{Binding HeaderText}" />
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Text="{Binding InfoText}" Margin="0,0,0,6" />
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBlock Text="Версия" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" DisplayMemberPath="Text" Width="140" Margin="0,0,12,0" />
                <Button Style="{StaticResource PrimaryButton}" MinWidth="0" Tag="&#xE896;" Content="Открыть" Command="{Binding OpenCommand}"
                        ToolTip="Открыть выбранную версию комплекта в рабочую папку" />
                <Button Style="{StaticResource IconButton}" Tag="&#xE8F1;" Content="Комплект" Command="{Binding ShowKitCommand}" />
                <Button Style="{StaticResource IconButton}" Tag="&#xE72D;" Content="Выгрузить комплект" Command="{Binding ExportCommand}" />
                <Button Style="{StaticResource IconButton}" Tag="&#xE7B3;" Content="{Binding UnusedCommandText}" Command="{Binding MarkUnusedCommand}"
                        Visibility="{Binding CanModify, Converter={StaticResource BoolVis}}" />
                <Button Style="{StaticResource IconButton}" Tag="&#xE72C;" Content="Обновить" Command="{Binding RefreshCommand}" />
            </WrapPanel>
            <TabControl SelectedIndex="{Binding SelectedSection}">
                <TabItem Header="Свойства">
                    <DockPanel Margin="4">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Конфигурация" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding Configurations}" SelectedItem="{Binding SelectedConfiguration}" MinWidth="220" />
                            <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Text="Свойства прочитаны из файла при сдаче; источник истины — сам CAD-файл." />
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding Properties}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Свойство" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Значение" Binding="{Binding Value}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="История версий">
                    <DataGrid ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" Margin="4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Версия" Binding="{Binding Text}" Width="Auto" />
                            <DataGridTextColumn Header="Автор" Binding="{Binding Author}" Width="Auto" />
                            <DataGridTextColumn Header="Дата" Binding="{Binding DateText}" Width="Auto" />
                            <DataGridTemplateColumn Header="Комментарий" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Comment}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Путь" Binding="{Binding RelPath}" Width="*" />
                            <DataGridTextColumn Header="Версия CAD" Binding="{Binding CadVersion}" Width="Auto" />
                            <DataGridTextColumn Header="Конфигурации" Binding="{Binding Configurations}" Width="Auto" />
                            <DataGridTextColumn Header="Размер" Binding="{Binding SizeText}" Width="Auto" />
                            <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha}" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Зависимости">
                    <DockPanel Margin="4">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,4"
                                   Text="Ссылки выбранной версии на конкретные версии других документов. Двойной щелчок — перейти к документу." />
                        <DataGrid x:Name="RefsGrid" ItemsSource="{Binding References}" MouseDoubleClick="OnRefDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="22" CellTemplate="{StaticResource MarkCell}" />
                                <DataGridTextColumn Header="Ссылка (как записана в файле)" Binding="{Binding RefPath}" Width="2*" />
                                <DataGridTextColumn Header="Документ в хранилище" Binding="{Binding ChildRelPath}" Width="2*" />
                                <DataGridTextColumn Header="Версия" Binding="{Binding VersionText}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Где применяется">
                    <DockPanel Margin="4">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding WhereUsedText}" TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="SemiBold" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,4"
                                   Text="Жёлтым отмечены применения не последней версии документа. Двойной щелчок — перейти к сборке или чертежу." />
                        <DataGrid x:Name="UsedGrid" ItemsSource="{Binding WhereUsed}" MouseDoubleClick="OnUsedDoubleClick">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UsesNotLatest}" Value="True">
                                            <Setter Property="Background" Value="#FFF4CE" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsThisVersion}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="22" CellTemplate="{StaticResource MarkCell}" />
                                <DataGridTextColumn Header="Где (сборка, чертёж, спецификация)" Binding="{Binding ParentRelPath}" Width="2*" />
                                <DataGridTextColumn Header="Обозначение" Binding="{Binding ParentDesignation}" Width="*" />
                                <DataGridTextColumn Header="Наименование" Binding="{Binding ParentName}" Width="*" />
                                <DataGridTextColumn Header="Версия родителя" Binding="{Binding ParentVersionText}" Width="Auto" />
                                <DataGridTextColumn Header="Использует" Binding="{Binding ChildVersionText}" Width="Auto" />
                                <DataGridTextColumn Header="Примечание" Binding="{Binding NoteText}" Width="1.3*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Производные файлы">
                    <Grid Margin="4">
                        <DataGrid ItemsSource="{Binding Derived}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Файл" Binding="{Binding FileName}" Width="2*" />
                                <DataGridTextColumn Header="Размер" Binding="{Binding SizeText}" Width="Auto" />
                                <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="У этой версии нет производных файлов (PDF, STEP, DXF…)." Style="{StaticResource Muted}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Visibility="{Binding Derived.Count, Converter={StaticResource CountVis}, ConverterParameter=invert}" />
                    </Grid>
                </TabItem>
                <TabItem Header="Журнал">
                    <DataGrid ItemsSource="{Binding Journal}" Margin="4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Когда" Binding="{Binding DateText}" Width="Auto" />
                            <DataGridTextColumn Header="Кто" Binding="{Binding User}" Width="Auto" />
                            <DataGridTextColumn Header="Действие" Binding="{Binding ActionText}" Width="Auto" />
                            <DataGridTextColumn Header="Версия" Binding="{Binding VersionText}" Width="Auto" />
                            <DataGridTextColumn Header="Подробности" Binding="{Binding DetailsText}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Grid>
</UserControl>
