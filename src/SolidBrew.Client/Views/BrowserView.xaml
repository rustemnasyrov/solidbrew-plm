<UserControl x:Class="SolidBrew.Client.Views.BrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cm="clr-namespace:System.ComponentModel;assembly=WindowsBase">
    <UserControl.Resources>
        <CollectionViewSource x:Key="ProjectsView" Source="{Binding Projects}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="160" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Проекты и библиотека -->
        <ListBox ItemsSource="{Binding Source={StaticResource ProjectsView}}" SelectedItem="{Binding SelectedProject}" BorderThickness="0"
                 Background="{StaticResource PanelBrush}">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="6,10,0,2" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="2,3">
                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" Margin="0,0,8,0" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="{Binding Name}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" />

        <DockPanel Grid.Column="2" Margin="8,6,6,6">
            <!-- Поиск -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="QueryBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Обозначение, наименование или имя файла">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock IsHitTestVisible="False" Text="Обозначение, наименование или имя файла" Margin="7,0,0,0" VerticalAlignment="Center"
                           Foreground="#9AA0A8" Visibility="{Binding Query, Converter={StaticResource NullVis}, ConverterParameter=invert}" />
                <TextBlock Grid.Column="1" Text="Автор" VerticalAlignment="Center" Margin="10,0,6,0" />
                <TextBox Grid.Column="2" Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}" ToolTip="Логин или имя автора последней версии">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <CheckBox Grid.Column="3" IsChecked="{Binding IncludeUnused}" Content="Показать неиспользуемые" VerticalAlignment="Center" Margin="10,0,10,0" />
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}" MinWidth="0" Tag="&#xE721;" Content="Найти" Command="{Binding SearchCommand}" />
                    <Button Style="{StaticResource IconButton}" Tag="&#xE894;" Content="Сбросить" Command="{Binding ClearSearchCommand}" Margin="0" />
                </StackPanel>
            </Grid>

            <!-- Команды над выбранным документом -->
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Button Style="{StaticResource PrimaryButton}" Tag="&#xE896;" Content="Открыть" Command="{Binding OpenCommand}"
                        ToolTip="Открыть последнюю версию комплекта в рабочую папку" />
                <Button Style="{StaticResource IconButton}" Tag="&#xE8F1;" Content="Комплект" Command="{Binding ShowKitCommand}" ToolTip="Дерево комплекта" />
                <Button Style="{StaticResource IconButton}" Tag="&#xE8A5;" Content="Документ" Command="{Binding ShowDocumentCommand}" ToolTip="Карточка документа: свойства, история, зависимости" />
                <Button Style="{StaticResource IconButton}" Tag="&#xE71B;" Content="Где применяется" Command="{Binding WhereUsedCommand}" />
                <Button Style="{StaticResource IconButton}" Tag="&#xE72D;" Content="Выгрузить комплект" Command="{Binding ExportCommand}" />
                <Button Style="{StaticResource IconButton}" Tag="&#xE7B3;" Content="Не используется" Command="{Binding MarkUnusedCommand}"
                        Visibility="{Binding CanModify, Converter={StaticResource BoolVis}}"
                        ToolTip="Пометить «не используется» (или вернуть). Документ пропадёт из поиска по умолчанию; история сохраняется." />
                <TextBlock Text="{Binding ResultText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </WrapPanel>

            <DataGrid ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument}" MouseDoubleClick="OnDoubleClick">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUnused}" Value="True">
                                <Setter Property="Foreground" Value="#9AA0A8" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="22" CellTemplate="{StaticResource MarkCell}" />
                    <DataGridTextColumn Header="Обозначение" Binding="{Binding Designation}" Width="*" SortMemberPath="Designation" />
                    <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="1.3*" />
                    <DataGridTextColumn Header="Файл" Binding="{Binding FileName}" Width="1.3*" />
                    <DataGridTextColumn Header="Вид" Binding="{Binding KindText}" Width="Auto" />
                    <DataGridTextColumn Header="Версия" Binding="{Binding VersionText}" Width="Auto" SortMemberPath="LatestVersion" />
                    <DataGridTextColumn Header="Автор" Binding="{Binding Author}" Width="Auto" />
                    <DataGridTextColumn Header="Дата" Binding="{Binding DateText}" Width="Auto" />
                    <DataGridTextColumn Header="Состояние" Binding="{Binding LockText}" Width="*" />
                    <DataGridTextColumn Header="Проект" Binding="{Binding ProjectName}" Width="Auto" />
                    <DataGridTextColumn Header="" Binding="{Binding StatusText}" Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
