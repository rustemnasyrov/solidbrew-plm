<Window x:Class="SolidBrew.Client.Views.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:SolidBrew.Client.Views"
        xmlns:inf="clr-namespace:SolidBrew.Client.Infrastructure"
        x:Name="Root"
        Style="{StaticResource AppWindow}"
        Width="1160" Height="800" MinWidth="820" MinHeight="560" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Toolbar}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource PrimaryButton}" Tag="&#xE898;" Content="Поставить на учёт" Command="{Binding ImportCommand}"
                            ToolTip="Одной операцией поставить на учёт все документы комплекта; исходники не меняются" />
                    <Button Style="{StaticResource PlainButton}" Content="Закрыть" Command="{Binding CancelCommand}" IsCancel="True" />
                </StackPanel>
                <StackPanel>
                    <!-- Что мешает поставить на учёт: каждая причина ведёт на свою вкладку и строку. -->
                    <Border Background="{StaticResource NoticeBrush}" Padding="8,4" Margin="0,0,0,6"
                            Visibility="{Binding HasBlockingReasons, Converter={StaticResource BoolVis}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource ErrorBrush}"
                                       Margin="0,2,8,0" VerticalAlignment="Top" />
                            <StackPanel>
                                <TextBlock Text="Нельзя поставить на учёт:" FontWeight="SemiBold" Foreground="{StaticResource ErrorBrush}" />
                                <ItemsControl ItemsSource="{Binding BlockingReasons}" AutomationProperties.Name="Нельзя поставить на учёт">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2,0,0">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource PlainButton}" Content="Прочитать заново" Margin="8,0,0,0"
                                                        VerticalAlignment="Top" Padding="8,1"
                                                        Command="{Binding DataContext.RereadCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                        Visibility="{Binding CanReread, Converter={StaticResource BoolVis}}"
                                                        ToolTip="Прочитать заново только эти файлы; остальной отчёт и решения сохраняются" />
                                                <TextBlock TextWrapping="Wrap">
                                                    <Hyperlink Command="{Binding DataContext.GoToReasonCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                               ToolTip="Показать на вкладке (щелчок ещё раз — следующая строка)">
                                                        <Run Text="{Binding Text, Mode=OneWay}" />
                                                    </Hyperlink>
                                                    <Run Text=" — " /><Run Text="{Binding Action, Mode=OneWay}" />
                                                </TextBlock>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <v:BusyBar DataContext="{Binding Busy}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Проект и комментарий. -->
        <Border DockPanel.Dock="Bottom" Padding="12,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Проект" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" DisplayMemberPath="Name" AutomationProperties.Name="Проект"
                          IsDropDownOpen="{Binding IsProjectDropDownOpen}">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
                <TextBlock Grid.Column="2" Text="Комментарий" VerticalAlignment="Center" Margin="16,0,8,0" />
                <TextBox Grid.Column="3" Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Grid.Row="1" Grid.ColumnSpan="4" Margin="0,8,0,0" IsChecked="{Binding AllowMissing}"
                          Content="Разрешить постановку с отсутствующими и неподтверждёнными ссылками (такие компоненты CAD не найдёт)" />
            </Grid>
        </Border>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource SubHeader}" Text="Головной документ" Margin="0,0,0,4" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Tag="&#xE8E5;" Content="Выбрать…" Command="{Binding BrowseHeadCommand}" Margin="6,0,0,0" />
                        <TextBox Text="{Binding HeadFile, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                               Text="Сборка (или деталь, чертёж) готового проекта, например на сетевом диске. Исходники только читаются: не перемещаются, не переименовываются и не изменяются. Папка головного файла — папка поиска." />
                    <Button HorizontalAlignment="Left" Margin="0,8,0,0" Style="{StaticResource PrimaryButton}" Tag="&#xE721;" Content="Прочитать ссылки"
                            Command="{Binding AnalyzeCommand}" />
                </StackPanel>
                <DockPanel Grid.Column="1">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SubHeader}" Text="Дополнительные папки поиска (чертежи, спецификации)" Margin="0,0,0,4" />
                    <StackPanel DockPanel.Dock="Right" Margin="6,0,0,0">
                        <Button Style="{StaticResource IconButton}" Tag="&#xE710;" Content="Добавить…" Command="{Binding AddFolderCommand}" Margin="0,0,0,4" />
                        <Button Style="{StaticResource IconButton}" Tag="&#xE738;" Content="Убрать" Command="{Binding RemoveFolderCommand}" Margin="0" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding ExtraFolders}" SelectedItem="{Binding SelectedFolder}" Height="72" />
                </DockPanel>
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,10,0,6" />
            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="6" MaxHeight="130" Margin="0,0,0,8"
                    Visibility="{Binding Problems.Count, Converter={StaticResource CountVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemTemplate}" />
                </ScrollViewer>
            </Border>

            <TabControl Grid.Row="3" SelectedIndex="{Binding SelectedTabIndex}">
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource ErrorBrush}" Margin="0,0,4,0"
                                       VerticalAlignment="Center" ToolTip="Здесь есть то, что мешает поставить на учёт"
                                       Visibility="{Binding DocumentsBlocked, Converter={StaticResource BoolVis}}" />
                            <TextBlock Text="{Binding DocumentsHeader}" />
                        </StackPanel>
                    </TabItem.Header>
                    <DataGrid ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument}" inf:ScrollSelection.IntoView="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Загружать" Width="75">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Include, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                                  IsEnabled="{Binding CanToggle}"
                                                  ToolTip="Загружать в PDM. Без галочки файл не загружается и остаётся ссылкой: CAD откроет его по пути из ссылки. Файл, уже учтённый в PDM, берётся из хранилища." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Путь в хранилище / исходник" Binding="{Binding RelPath}" Width="2*" />
                            <DataGridTextColumn Header="Обозначение" Binding="{Binding Designation}" Width="*" />
                            <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Вид" Binding="{Binding KindText}" Width="Auto" />
                            <DataGridTextColumn Header="Откуда" Binding="{Binding RoleText}" Width="Auto" />
                            <DataGridTextColumn Header="Версия CAD" Binding="{Binding CadVersion}" Width="Auto" />
                            <DataGridTextColumn Header="Что будет" Binding="{Binding DispositionText}" Width="1.5*" />
                            <DataGridTextColumn Header="Ошибка чтения" Binding="{Binding ReadError}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="{Binding FoundHeader}">
                    <DataGrid ItemsSource="{Binding Found}" SelectedItem="{Binding SelectedFound}" inf:ScrollSelection.IntoView="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Документ" Binding="{Binding SourceName}" Width="*" />
                            <DataGridTextColumn Header="Ссылка (как записана)" Binding="{Binding SavedPath}" Width="2*" />
                            <DataGridTextColumn Header="Найден" Binding="{Binding TargetPath}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource ErrorBrush}" Margin="0,0,4,0"
                                       VerticalAlignment="Center" ToolTip="Здесь есть то, что мешает поставить на учёт"
                                       Visibility="{Binding OutsideBlocked, Converter={StaticResource BoolVis}}" />
                            <TextBlock Text="{Binding OutsideHeader}" />
                        </StackPanel>
                    </TabItem.Header>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="4"
                                   Text="Файл есть по сохранённому пути, но вне указанных папок. Подтвердите, если это нужный файл, или добавьте его папку в поиск." />
                        <DataGrid ItemsSource="{Binding Outside}" SelectedItem="{Binding SelectedOutside}" inf:ScrollSelection.IntoView="True">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Подтвердить" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Accept, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Документ" Binding="{Binding SourceName}" Width="*" />
                                <DataGridTextColumn Header="Ссылка (как записана)" Binding="{Binding SavedPath}" Width="2*" />
                                <DataGridTextColumn Header="Найден" Binding="{Binding TargetPath}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource ErrorBrush}" Margin="0,0,4,0"
                                       VerticalAlignment="Center" ToolTip="Здесь есть то, что мешает поставить на учёт"
                                       Visibility="{Binding NameOnlyBlocked, Converter={StaticResource BoolVis}}" />
                            <TextBlock Text="{Binding NameOnlyHeader}" />
                        </StackPanel>
                    </TabItem.Header>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="4"
                                   Text="По сохранённому пути файла нет; в папках поиска найден один файл с таким же именем. PDM не выбирает файл по имени сама — подтвердите, что это тот файл." />
                        <DataGrid ItemsSource="{Binding NameOnly}" SelectedItem="{Binding SelectedNameOnly}" inf:ScrollSelection.IntoView="True">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Подтвердить" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Accept, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Документ" Binding="{Binding SourceName}" Width="*" />
                                <DataGridTextColumn Header="Ссылка (как записана)" Binding="{Binding SavedPath}" Width="2*" />
                                <DataGridTextColumn Header="Найден файл с тем же именем" Binding="{Binding TargetPath}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem Visibility="{Binding Relocated.Count, Converter={StaticResource CountVis}}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource ErrorBrush}" Margin="0,0,4,0"
                                       VerticalAlignment="Center" ToolTip="Здесь есть то, что мешает поставить на учёт"
                                       Visibility="{Binding RelocatedBlocked, Converter={StaticResource BoolVis}}" />
                            <TextBlock Text="{Binding RelocatedHeader}" />
                        </StackPanel>
                    </TabItem.Header>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="4" TextWrapping="Wrap"
                                   Text="По сохранённому пути файла нет, но документ перенесён (папку переименовали или переместили), и файл найден на том же месте относительно него, что и до переноса. PDM не принимает его сама — подтвердите, что это тот файл." />
                        <DataGrid ItemsSource="{Binding Relocated}" SelectedItem="{Binding SelectedRelocated}" inf:ScrollSelection.IntoView="True">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Подтвердить" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Accept, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Документ" Binding="{Binding SourceName}" Width="*" />
                                <DataGridTextColumn Header="Ссылка (как записана)" Binding="{Binding SavedPath}" Width="2*" />
                                <DataGridTextColumn Header="Найден на прежнем месте" Binding="{Binding TargetPath}" Width="2*" />
                                <DataGridTextColumn Header="Перенос папки" Binding="{Binding MovedText}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource ErrorBrush}" Margin="0,0,4,0"
                                       VerticalAlignment="Center" ToolTip="Здесь есть то, что мешает поставить на учёт"
                                       Visibility="{Binding AmbiguousBlocked, Converter={StaticResource BoolVis}}" />
                            <TextBlock Text="{Binding AmbiguousHeader}" />
                        </StackPanel>
                    </TabItem.Header>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="4"
                                   Text="По сохранённому пути файла нет, а файлов с таким именем несколько. Выберите нужный вариант." />
                        <DataGrid ItemsSource="{Binding Ambiguous}" SelectedItem="{Binding SelectedAmbiguous}" inf:ScrollSelection.IntoView="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Документ" Binding="{Binding SourceName}" Width="*" />
                                <DataGridTextColumn Header="Ссылка (как записана)" Binding="{Binding SavedPath}" Width="1.5*" />
                                <DataGridTemplateColumn Header="Вариант" Width="2.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding Chosen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource ErrorBrush}" Margin="0,0,4,0"
                                       VerticalAlignment="Center" ToolTip="Здесь есть то, что мешает поставить на учёт"
                                       Visibility="{Binding MissingBlocked, Converter={StaticResource BoolVis}}" />
                            <TextBlock Text="{Binding MissingHeader}" />
                        </StackPanel>
                    </TabItem.Header>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="4"
                                   Text="Файл не найден ни по сохранённому пути, ни по имени в папках поиска. Добавьте папку с ним в поиск или разрешите постановку с отсутствующими ссылками." />
                        <DataGrid ItemsSource="{Binding Missing}" SelectedItem="{Binding SelectedMissing}" inf:ScrollSelection.IntoView="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Документ" Binding="{Binding SourceName}" Width="*" />
                                <DataGridTextColumn Header="Ссылка (как записана)" Binding="{Binding SavedPath}" Width="3*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
