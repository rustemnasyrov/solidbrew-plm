<UserControl x:Class="SolidBrew.Client.Views.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SolidBrew.Client.ViewModels">
    <TabControl Margin="18,4,18,8" Style="{StaticResource FlatTabs}">
        <TabItem Header="Пользователи и роли">
            <DockPanel Margin="8">
                <!-- Новый пользователь -->
                <GroupBox DockPanel.Dock="Bottom" Header="Новый пользователь" Padding="6" Margin="0,8,0,0">
                    <WrapPanel>
                        <TextBlock Text="Логин" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Width="130" Text="{Binding NewLogin, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0" />
                        <TextBlock Text="Имя" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Width="200" Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0" />
                        <TextBlock Text="Пароль" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Width="130" Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0"
                                 ToolTip="Временный пароль; сообщите его пользователю" />
                        <TextBlock Text="Роль" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox Width="140" ItemsSource="{x:Static vm:AdminViewModel.Roles}" DisplayMemberPath="Text" SelectedItem="{Binding NewRole}" Margin="0,0,12,0" />
                        <Button Style="{StaticResource PrimaryButton}" MinWidth="0" Tag="&#xE8FA;" Content="Создать" Command="{Binding CreateUserCommand}" />
                    </WrapPanel>
                </GroupBox>
                <!-- Выбранный пользователь -->
                <GroupBox DockPanel.Dock="Bottom" Header="Выбранный пользователь" Padding="6" Margin="0,8,0,0">
                    <WrapPanel>
                        <TextBlock Text="Роль" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox Width="140" ItemsSource="{x:Static vm:AdminViewModel.Roles}" DisplayMemberPath="Text" SelectedItem="{Binding SelectedUserRole}" Margin="0,0,6,0" />
                        <Button Style="{StaticResource IconButton}" Tag="&#xE8D7;" Content="Сменить роль" Command="{Binding ChangeRoleCommand}" Margin="0,0,16,0" />
                        <TextBlock Text="Новый пароль" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Width="140" Text="{Binding ResetPassword, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
                        <Button Style="{StaticResource IconButton}" Tag="&#xE8D7;" Content="Сменить пароль" Command="{Binding SetPasswordCommand}" Margin="0,0,16,0" />
                        <Button Style="{StaticResource IconButton}" Tag="&#xE8F8;" Content="{Binding SelectedUser.ToggleText, FallbackValue=Отключить}" Command="{Binding ToggleActiveCommand}" />
                    </WrapPanel>
                </GroupBox>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Tag="&#xE72C;" Content="Обновить" Command="{Binding LoadUsersCommand}" Margin="0" />
                    <TextBlock Style="{StaticResource Header}" Text="Пользователи" Margin="0" />
                </DockPanel>
                <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="*" />
                        <DataGridTextColumn Header="Имя" Binding="{Binding DisplayName}" Width="2*" />
                        <DataGridTextColumn Header="Роль" Binding="{Binding RoleText}" Width="Auto" />
                        <DataGridTextColumn Header="Состояние" Binding="{Binding ActiveText}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>
        <TabItem Header="Блокировки">
            <DockPanel Margin="8">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Tag="&#xE785;" Content="Снять блокировку" Command="{Binding ForceUnlockCommand}" />
                        <Button Style="{StaticResource IconButton}" Tag="&#xE72C;" Content="Обновить" Command="{Binding LoadLocksCommand}" Margin="0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Header}" Text="Текущие блокировки" Margin="0" />
                        <TextBlock Style="{StaticResource Muted}" Text="Принудительное снятие фиксируется в журнале; владелец получит уведомление, его локальные правки не удаляются." />
                    </StackPanel>
                </DockPanel>
                <DataGrid ItemsSource="{Binding Locks}" SelectedItem="{Binding SelectedLock}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Документ" Binding="{Binding DocumentText}" Width="2*" />
                        <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Проект" Binding="{Binding ProjectName}" Width="Auto" />
                        <DataGridTextColumn Header="Взят" Binding="{Binding UserText}" Width="*" />
                        <DataGridTextColumn Header="С" Binding="{Binding SinceText}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>
        <TabItem Header="Проекты и библиотека">
            <DockPanel Margin="8">
                <GroupBox DockPanel.Dock="Bottom" Header="Создать" Padding="6" Margin="0,8,0,0">
                    <WrapPanel>
                        <TextBlock Text="Название" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Width="260" Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0" />
                        <TextBlock Text="Вид" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox Width="130" ItemsSource="{x:Static vm:AdminViewModel.ProjectKinds}" DisplayMemberPath="Text" SelectedItem="{Binding NewProjectKind}" Margin="0,0,12,0" />
                        <Button Style="{StaticResource PrimaryButton}" MinWidth="0" Tag="&#xE710;" Content="Создать" Command="{Binding CreateProjectCommand}" />
                    </WrapPanel>
                </GroupBox>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Tag="&#xE72C;" Content="Обновить" Command="{Binding LoadProjectsCommand}" Margin="0" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource Header}" Text="Проекты и библиотека" Margin="0" />
                        <TextBlock Style="{StaticResource Muted}" Text="Библиотека — стандартные изделия, крепёж и покупные компоненты; конструкторы используют её только для чтения." />
                    </StackPanel>
                </DockPanel>
                <DataGrid ItemsSource="{Binding Projects}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Вид" Binding="{Binding Kind}" Width="Auto" />
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>
        <TabItem Header="Рабочие версии CAD">
            <DockPanel Margin="8">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}" MinWidth="0" Tag="&#xE74E;" Content="Сохранить" Command="{Binding SaveSettingsCommand}" />
                        <Button Style="{StaticResource IconButton}" Tag="&#xE72C;" Content="Обновить" Command="{Binding LoadSettingsCommand}" Margin="0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Header}" Text="Настройки сервера" Margin="0" />
                        <TextBlock Style="{StaticResource Muted}"
                                   Text="Рабочая версия CAD — номер года, например 2018. Файлы, сохранённые в более новой версии, сдаются только после предупреждения." />
                    </StackPanel>
                </DockPanel>
                <DataGrid ItemsSource="{Binding Settings}" IsReadOnly="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Параметр" Binding="{Binding Title}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Ключ" Binding="{Binding Key}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Значение" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>
        <TabItem Header="Журнал">
            <DockPanel Margin="8">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="Записей" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Width="70" Text="{Binding JournalLimit, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
                        <Button Style="{StaticResource IconButton}" Tag="&#xE72C;" Content="Обновить" Command="{Binding LoadJournalCommand}" Margin="0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Header}" Text="Журнал действий" Margin="0" />
                </DockPanel>
                <DataGrid ItemsSource="{Binding Journal}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Когда" Binding="{Binding DateText}" Width="Auto" />
                        <DataGridTextColumn Header="Кто" Binding="{Binding User}" Width="Auto" />
                        <DataGridTextColumn Header="Действие" Binding="{Binding ActionText}" Width="Auto" />
                        <DataGridTextColumn Header="Документ" Binding="{Binding DocumentText}" Width="Auto" />
                        <DataGridTextColumn Header="Версия" Binding="{Binding VersionText}" Width="Auto" />
                        <DataGridTextColumn Header="Подробности" Binding="{Binding DetailsText}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>
    </TabControl>
</UserControl>
