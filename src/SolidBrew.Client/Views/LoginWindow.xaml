<Window x:Class="SolidBrew.Client.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SolidBrew.Client.ViewModels"
        Style="{StaticResource AppWindow}"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=PasswordInput}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource AccentBrush}" Padding="20,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" FontSize="26" Foreground="White" Margin="0,0,12,0" />
                <StackPanel>
                    <TextBlock Text="SolidBrew PDM" FontSize="20" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="Хранилище конструкторских документов" Foreground="#DCE8F7" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Grid Margin="20,16,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Сервер" VerticalAlignment="Center" Margin="0,0,10,8" />
            <TextBox Grid.Column="1" Margin="0,0,0,8" Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Адрес сервера PDM, например http://10.0.1.9:8088/" />
            <TextBlock Grid.Row="1" Text="Логин" VerticalAlignment="Center" Margin="0,0,10,8" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="2" Text="Пароль" VerticalAlignment="Center" Margin="0,0,10,8" />
            <PasswordBox x:Name="PasswordInput" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" PasswordChanged="OnPasswordChanged" />
            <CheckBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" IsChecked="{Binding Remember}"
                      Content="Запомнить (не спрашивать пароль на этом компьютере)" />
            <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
                       Margin="0,0,0,8" Visibility="{Binding ErrorMessage, Converter={StaticResource NullVis}}" />
            <DockPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="0,0,0,4" Visibility="{Binding Busy.IsBusy, Converter={StaticResource BoolVis}}">
                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,4" DockPanel.Dock="Top" />
                <TextBlock Text="{Binding Busy.StatusText}" Style="{StaticResource Muted}" />
            </DockPanel>
            <DockPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="0,8,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Tag="&#xE713;" Content="Настройки…" Command="{Binding OpenSettingsCommand}" />
                <Button DockPanel.Dock="Right" Style="{StaticResource PlainButton}" Content="Отмена" Command="{Binding CancelCommand}" IsCancel="True" />
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Tag="&#xE8D7;" Content="Войти" Command="{Binding LoginCommand}" IsDefault="True" Margin="0" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
