<Window x:Class="SolidBrew.Client.Views.StartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SolidBrew.Client.ViewModels"
        x:Name="Root"
        Style="{StaticResource AppWindow}"
        Width="760" Height="680" MinWidth="560" MinHeight="460">
    <Window.Resources>
        <CollectionViewSource x:Key="Items" Source="{Binding Catalog.Items}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>
    <DockPanel Margin="28,22,28,18">
        <!-- Заголовок -->
        <DockPanel DockPanel.Dock="Top">
            <TextBlock DockPanel.Dock="Right" Text="{Binding UserText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Top" Margin="0,6,0,0" />
            <StackPanel>
                <TextBlock Text="Выберите изделие" Style="{StaticResource Title}" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                           Text="Изделие — любая сборка. Окно показывает её дерево с чертежами и рабочую папку." />
            </StackPanel>
        </DockPanel>

        <!-- Поиск -->
        <Grid DockPanel.Dock="Top" Margin="0,18,0,10">
            <TextBox x:Name="Search" Text="{Binding Catalog.Query, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="30,6,8,6" />
            <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Margin="10,0,0,0" Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False" />
            <TextBlock Text="Поиск по всем сборкам: обозначение, наименование, имя файла" Margin="32,0,0,0" VerticalAlignment="Center" FontSize="14"
                       Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False"
                       Visibility="{Binding Catalog.Query, Converter={StaticResource NullVis}, ConverterParameter=invert}" />
        </Grid>

        <!-- Действия -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource PlainButton}" Content="Закрыть" Command="{Binding CancelCommand}" IsCancel="True" />
            <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Tag="&#xE8B5;" Content="Поставить на учёт новое изделие"
                    Command="{Binding ImportCommand}" Visibility="{Binding CanModify, Converter={StaticResource BoolVis}}" HorizontalAlignment="Left" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Catalog.StatusText}" Style="{StaticResource Muted}" Margin="0,6,0,0"
                   Visibility="{Binding Catalog.StatusText, Converter={StaticResource NullVis}}" />

        <Grid>
            <TextBlock Text="Список пуст. Найдите сборку поиском или поставьте на учёт новое изделие." Style="{StaticResource Muted}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Catalog.IsEmpty, Converter={StaticResource BoolVis}}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Source={StaticResource Items}}">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource MutedBrush}" Margin="8,14,0,4" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProductItem}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GlyphButton}" Content="{Binding PinGlyph}" ToolTip="Закрепить / открепить"
                                        Command="{Binding DataContext.Catalog.TogglePinCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                <Button Style="{StaticResource FlatButton}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Title}" Padding="10,7"
                                        Command="{Binding DataContext.OpenCommand, ElementName=Root}" CommandParameter="{Binding}">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <ContentPresenter Content="{Binding}" />
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE8F1;" FontSize="18" Foreground="{StaticResource AccentBrush}"
                                                   Margin="0,0,12,0" VerticalAlignment="Top" />
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock Text="{Binding Subtitle}" Margin="10,0,0,0" FontSize="14" Foreground="{StaticResource MutedBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding Details, Converter={StaticResource NullVis}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
