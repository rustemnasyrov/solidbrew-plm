<Window x:Class="SolidBrew.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:SolidBrew.Client.Views"
        Style="{StaticResource AppWindow}"
        Title="{Binding Title}" Width="1380" Height="860" MinWidth="980" MinHeight="600" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Верхняя панель: рабочая папка, основные команды, пользователь. -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Toolbar}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE77B;" Margin="12,0,6,0" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding UserText}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="{Binding ServerText}" />
                    <Button Style="{StaticResource IconButton}" Tag="&#xE713;" Content="Настройки" Command="{Binding OpenSettingsCommand}" />
                    <Button Style="{StaticResource IconButton}" Tag="&#xE7E8;" Content="Выйти" Command="{Binding LogoutCommand}" Margin="0" />
                </StackPanel>
                <WrapPanel>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Margin="0,0,6,0" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="Рабочая папка" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox Width="360" ItemsSource="{Binding Flow.RecentWorkspaces}" SelectedItem="{Binding SelectedWorkRoot}"
                              ToolTip="Недавние рабочие папки" Margin="0,0,6,0" />
                    <Button Style="{StaticResource IconButton}" Tag="&#xE838;" Content="Выбрать…" Command="{Binding ChooseWorkRootCommand}" />
                    <Button Style="{StaticResource IconButton}" Tag="&#xEC50;" Content="Проводник" Command="{Binding ShowWorkRootCommand}" />
                    <Border Width="1" Margin="4,2,10,2" Background="{StaticResource BorderBrush}" />
                    <Button Style="{StaticResource IconButton}" Tag="&#xE8B5;" Content="Поставить на учёт" Command="{Binding ImportCommand}"
                            Visibility="{Binding CanModify, Converter={StaticResource BoolVis}}" ToolTip="Поставить на учёт готовый проект (например, с сетевого диска)" />
                    <Button Style="{StaticResource IconButton}" Tag="&#xE898;" Content="Сдать…" Command="{Binding CheckinCommand}"
                            Visibility="{Binding CanModify, Converter={StaticResource BoolVis}}" ToolTip="Сдать новые и изменённые документы рабочей папки" />
                    <Button Style="{StaticResource IconButton}" Tag="&#xE72C;" Content="Обновить" Command="{Binding RefreshCommand}" ToolTip="Обновить текущую вкладку" />
                    <TextBlock Text="Режим просмотра (читатель)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource WarningBrush}"
                               Visibility="{Binding IsReader, Converter={StaticResource BoolVis}}" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Уведомления (например, о принудительно снятой блокировке). -->
        <Border DockPanel.Dock="Top" Background="{StaticResource NoticeBrush}" BorderBrush="#E8D48A" BorderThickness="0,0,0,1" Padding="10,6"
                Visibility="{Binding HasNotices, Converter={StaticResource BoolVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Tag="&#xE73E;" Content="Прочитано" Command="{Binding DismissNoticesCommand}"
                        VerticalAlignment="Top" Margin="8,0,0,0" />
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xEA8F;" FontSize="16" VerticalAlignment="Top" Margin="0,2,8,0" />
                <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Notices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Строка состояния: ход операции и «Отменить». -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Toolbar}" BorderThickness="0,1,0,0" Padding="8,3">
            <v:BusyBar DataContext="{Binding Busy}" />
        </Border>

        <TabControl SelectedIndex="{Binding SelectedTab}" Margin="6" Padding="0">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Margin="0,0,6,0" />
                        <TextBlock Text="Обзор" />
                    </StackPanel>
                </TabItem.Header>
                <v:BrowserView DataContext="{Binding Browser}" />
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" Margin="0,0,6,0" />
                        <TextBlock Text="Комплект" />
                    </StackPanel>
                </TabItem.Header>
                <v:KitView DataContext="{Binding Kit}" />
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Margin="0,0,6,0" />
                        <TextBlock Text="Рабочая папка" />
                    </StackPanel>
                </TabItem.Header>
                <v:WorkFolderView DataContext="{Binding WorkFolder}" />
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" Margin="0,0,6,0" />
                        <TextBlock Text="Документ" />
                    </StackPanel>
                </TabItem.Header>
                <v:DocumentView DataContext="{Binding Document}" />
            </TabItem>
            <TabItem Visibility="{Binding IsAdmin, Converter={StaticResource BoolVis}}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE716;" Margin="0,0,6,0" />
                        <TextBlock Text="Администрирование" />
                    </StackPanel>
                </TabItem.Header>
                <v:AdminView DataContext="{Binding Admin}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
